{
  "name": "dsh-convo-cost",
  "version": "1.0.0",
  "description": "Real-time cost tracking for the current DSH conversation: a composer-dock line showing the running token usage and DeepSeek official price estimate (base and peak/valley pricing).",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "cost",
    "usage",
    "tokens",
    "billing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ljr282341583/dsh-convo-cost.git"
  },
  "homepage": "https://github.com/ljr282341583/dsh-convo-cost#readme",
  "bugs": {
    "url": "https://github.com/ljr282341583/dsh-convo-cost/issues"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
